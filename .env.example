# Postgres (docker compose up -d starts one matching this URL)
DATABASE_URL="postgresql://knit:knit@localhost:5432/knitsomesweet"

# Auth.js: a long random string, e.g. from `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=""

# The single seller account. Create the hash with: npm run hash-password -- "your password"
SELLER_EMAIL="seller@example.com"
SELLER_PASSWORD_HASH=""

# Time zone for dashboard days (IANA name)
SHOP_TIME_ZONE="Asia/Kuala_Lumpur"

# Seller's WhatsApp number, digits only with country code (optional)
NEXT_PUBLIC_SELLER_WHATSAPP=""
