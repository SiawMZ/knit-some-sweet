# Postgres (docker compose up -d starts one matching this URL)
DATABASE_URL="postgresql://knit:knit@localhost:5432/knitsomesweet"
# The live shop's database (Neon), used only by `npm run drawings` and /draw-requests,
# so the drawing queue is always the seller's real one while the app runs on Docker.
LIVE_DATABASE_URL=""
# Optional non-pooled URL for `prisma migrate`. Set it in production when
# DATABASE_URL goes through a pooler, e.g. Neon's "-pooler" host.
DIRECT_URL=""

# Auth.js: a long random string, e.g. from `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=""

# The single seller account. Create the hash with: npm run hash-password -- "your password"
SELLER_EMAIL="seller@example.com"
SELLER_PASSWORD_HASH=""

# Time zone for dashboard days (IANA name)
SHOP_TIME_ZONE="Asia/Kuala_Lumpur"

# Seller's WhatsApp number, digits only with country code (optional)
NEXT_PUBLIC_SELLER_WHATSAPP=""

# Notify the developer when the seller sends a drawing request (optional).
# An ntfy.sh topic URL, a Discord or Slack incoming webhook, or any URL that takes a JSON POST.
DRAWING_REQUEST_WEBHOOK_URL=""
# Only needed when the host doesn't tell: ntfy (e.g. self-hosted), discord, slack or json
DRAWING_REQUEST_WEBHOOK_FORMAT=""
